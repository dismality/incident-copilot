# Start with demo mode: no model key is needed and the complete workflow works.
AGENT_MODE=demo

# To enable live model-driven investigation, switch to openai and provide a key.
# Never commit the real key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

DATABASE_URL=postgresql+psycopg://resolveops:resolveops@postgres:5432/resolveops
SIMULATOR_BASE_URL=http://simulator:8081
DASHBOARD_ORIGIN=http://localhost:8501
RESOLVEOPS_API_URL=http://api:8000
